# Copy to app/.env and fill in. app/.env is git-ignored. Never commit real values.

# Live mode: Postgres connection for the least-privilege app role (docs/SETUP_POSTGRES.md, step 4)
DATABASE_URL=postgresql://monetizeiq_app:CHANGE_ME@localhost:5432/monetizeiq
# Only for npm run db:setup: a role that can create schemas and roles (docs/SETUP_POSTGRES.md, step 2)
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/monetizeiq

# Web console (defaults shown). Set MONETIZEIQ_HOST=0.0.0.0 only if you want other machines to reach it.
MONETIZEIQ_HOST=127.0.0.1
MONETIZEIQ_PORT=3000
# MONETIZEIQ_MODE=offline

# Slack bot, optional (docs/SETUP_SLACK.md)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Map Slack user IDs to account owners who may approve: U01ABC=riley,U02DEF=jordan
SLACK_APPROVERS=
